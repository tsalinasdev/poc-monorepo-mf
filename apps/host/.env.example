# Module Federation — manifest URL of each remote.
# Dev: the remote's vite dev server, serving mf-manifest.json next to remoteEntry.js
# (the plugin emits it when `manifest: true` is set in module-federation.config.ts).
# Prod: the bucket/CDN URL where the manifest lives.
# See ADR 0005 — the host reads the manifest FIRST, not the remoteEntry.js, so it
# can decide which exposes to fetch before paying for the remote's runtime init.
VITE_REMOTE_DRAGONBALL_MANIFEST_URL=http://localhost:5175/mf-manifest.json
VITE_REMOTE_KPI_MANIFEST_URL=http://localhost:5176/mf-manifest.json