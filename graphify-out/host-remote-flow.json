  "cards": [
    {
      "dot": "cyan",
      "title": "Startup Flow",
      "items": [
        "1. Browser → Host shell",
        "2. Host calls registerRemoteRoutes()",
        "3. probeAndWrap() eagerly loads each remote",
        "4. allSettled catches failures",
        "5. Routes registered or degraded"
      ]
    },
    {
      "dot": "emerald",
      "title": "Runtime Flow",
      "items": [
        "1. Navigate to /pokemons",
        "2. MF Bridge mounts remote component",
        "3. Remote calls API via host proxy",
        "4. Proxy rewrites to external API",
        "5. Data flows back to remote"
      ]
    },
    {
      "dot": "violet",
      "title": "Degraded Mode",
      "items": [
        "1. probeAndWrap() fails for remote",
        "2. allSettled detects rejection",
        "3. Unavailable route registered",
        "4. Remote stays in navbar",
        "5. Other remotes unaffected"
      ]
    }
  ]
